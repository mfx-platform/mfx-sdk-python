{#- Overrides openapi-python-client's int_enum template: the class gains _read, which
    reads a number this SDK was not generated with as an UNKNOWN pseudo-member keeping the number,
    instead of failing the call. Calling the class itself stays strict. -#}
from enum import IntEnum

class {{ enum.class_info.name }}(IntEnum):
    {% for key, value in enum.values.items() %}
    {{ key }} = {{ value }}
    {% endfor %}

    def __str__(self) -> str:
        return str(self.value)

    @classmethod
    def _read(cls, value: int) -> "{{ enum.class_info.name }}":
        """A number from a response: its member, or, for a number a later version of the API
        added, an UNKNOWN pseudo-member whose value is the number as sent."""
        try:
            return cls(value)
        except ValueError:
            if not isinstance(value, int) or isinstance(value, bool):
                raise
        unknown = int.__new__(cls, value)
        unknown._name_ = "UNKNOWN"
        unknown._value_ = value
        return unknown
